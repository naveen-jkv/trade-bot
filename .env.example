# ==============================================================================
# AUTONOMOUS AI TRADING BOT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TRADING ENVIRONMENT & BROKER CONFIGURATION
# ------------------------------------------------------------------------------
# Modes:
#   - MOCK  : Local offline simulated matching engine (zero risk, offline sandbox)
#   - PAPER : Alpaca Paper Trading (connects to https://paper-api.alpaca.markets with virtual capital)
#   - LIVE  : Alpaca Live Real-Money Trading (connects to https://api.alpaca.markets with REAL FUNDS)
TRADING_MODE=PAPER

# Alpaca API Credentials (Required for PAPER and LIVE modes)
# Obtain from your Alpaca dashboard: https://app.alpaca.markets
ALPACA_API_KEY=your_alpaca_api_key_id_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# ------------------------------------------------------------------------------
# 2. REAL-MONEY SAFETY TRIPWIRE (MANDATORY FOR LIVE TRADING)
# ------------------------------------------------------------------------------
# To prevent accidental real-money execution, the system has an immutable safety lock.
# When TRADING_MODE=LIVE, you MUST explicitly set this to TRUE to authorize orders.
# If FALSE or omitted, all real-money orders are blocked by the Risk Firewall.
CONFIRM_REAL_MONEY_TRADING=FALSE

# ------------------------------------------------------------------------------
# 3. REAL-MONEY RISK CONTROLS & SAFETY CEILINGS
# ------------------------------------------------------------------------------
# Hard ceiling on maximum USD notional value for any single order.
# Protects against fat-finger errors or anomalous position sizing.
MAX_ORDER_USD=500.0

# Emergency Kill Switch: immediately halts all order routing when set to TRUE
TRADING_KILL_SWITCH=FALSE

# Maximum acceptable daily loss (%) before autonomous trading halts
MAX_DAILY_DRAWDOWN_PCT=3.5

# Maximum risk per individual trade (% of equity)
RISK_PER_TRADE_PCT=1.5

# Maximum concurrent open positions allowed
MAX_OPEN_POSITIONS=3

# ------------------------------------------------------------------------------
# 4. LLM INTELLIGENCE PROVIDER (Optional)
# ------------------------------------------------------------------------------
# Provider: 'auto', 'gemini', 'openai', 'ollama', or 'heuristic'
LLM_PROVIDER=auto
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 5. MULTI-CHANNEL OPERATIONAL ALERTS (Telegram / Discord / Generic Webhooks)
# ------------------------------------------------------------------------------
# Set to TRUE to dispatch alerts on trade executions, kill switch triggers, and drawdowns
ALERTS_ENABLED=TRUE

# Telegram Bot configuration (token from @BotFather, chat ID from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook configuration (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=

# Generic HTTP Webhook endpoint (receives JSON POST payloads)
ALERT_WEBHOOK_URL=

